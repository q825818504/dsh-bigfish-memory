{
  "name": "dsh-dafeiyu-memory",
  "version": "1.3.2",
  "description": "大肥鱼的本地持久记忆：会话/工作区绑定、可选存储位置与侧栏管理",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cli.js",
    "cordis.patch.yml",
    "README.md",
    "PRODUCT.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "bin": {
    "dafeiyu-memory": "cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-directory-picker-native",
        "@deepseek-ai/dsh-client-ui-directory-picker-browse"
      ]
    }
  },
  "engines": {
    "node": ">=22.16.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "test": "node --test ./scope-backup.test.js"
  },
  "license": "MIT"
}
